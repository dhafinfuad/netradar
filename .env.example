# Database Connection (MySQL / MariaDB via PyMySQL)
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/db_aplikasi

# Security & Session Secret Key (Change this in production!)
SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production

# PowerShell Agent Script API Token
SCRIPT_API_TOKEN=your_script_api_token_here

# Ping Background Scanner Interval (in minutes)
PING_INTERVAL_MINUTES=3
